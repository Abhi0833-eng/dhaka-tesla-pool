generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  passwordHash        String
  role                String         @default("PASSENGER") // PASSENGER | DRIVER | ADMIN
  walletBalancePoysha Int            @default(50000) // 500.00 BDT in Poysha
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  
  // Relations
  vehicle             Vehicle?
  rideRequests        RideRequest[]  @relation("PassengerRides")
  auditLogs           RideAuditLog[]
}

model Vehicle {
  id           String   @id @default(uuid())
  driverId     String   @unique
  driver       User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  model        String   // e.g. "Bullet (3-seat Battery Tesla)"
  licensePlate String   // e.g. "DHAKA-METRO-T-11"
  capacity     Int      @default(3) // Bullet fixed 3-seat capacity
  isOnline     Boolean  @default(true)
  currentZone  String   @default("Banani")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  pools        Pool[]
}

model Pool {
  id              String        @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  status          String        @default("OPEN") // OPEN | FULL | IN_PROGRESS | COMPLETED | CANCELLED
  totalSeats      Int           @default(3)
  occupiedSeats   Int           @default(0)
  availableSeats  Int           @default(3)
  pickupZone      String        @default("Banani")
  destinationZone String        @default("Mohakhali")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  rideRequests    RideRequest[]
}

model RideRequest {
  id                  String       @id @default(uuid())
  passengerId         String
  passenger           User         @relation("PassengerRides", fields: [passengerId], references: [id], onDelete: Cascade)
  poolId              String?
  pool                Pool?        @relation(fields: [poolId], references: [id], onDelete: SetNull)
  
  pickupZone          String
  destinationZone     String
  seatsRequested      Int          @default(1)
  status              String       @default("REQUESTED") // REQUESTED | MATCHED | DRIVER_ARRIVED | STARTED | COMPLETED | CANCELLED
  
  // Money in Poysha (integers)
  fareBasePoysha      Int          @default(5000) // 50 BDT
  fareDistancePoysha  Int          @default(0)
  fareDiscountPoysha  Int          @default(0)
  finalFarePoysha     Int          @default(5000)
  distanceKm          Float        @default(3.0)
  isPooled            Boolean      @default(false)

  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  auditLogs           RideAuditLog[]

  @@index([passengerId])
  @@index([poolId])
  @@index([status])
}

model RideAuditLog {
  id              String      @id @default(uuid())
  rideRequestId   String
  rideRequest     RideRequest @relation(fields: [rideRequestId], references: [id], onDelete: Cascade)
  fromStatus      String
  toStatus        String
  changedByUserId String
  changedByUser   User        @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)
  note            String?
  createdAt       DateTime    @default(now())
}
